# The React demo calls the local server from january-server-sdk-node.
PARTNER_TOKEN_URL=http://127.0.0.1:8787/api/january/token
PARTNER_APP_SESSION_TOKEN=january-local-demo
JANUARY_END_USER_ID=january-sdk-demo-user

# Optional debug-only shortcut. Keep these server-side and never use VITE_.
# JANUARY_API_KEY=sk-your-local-development-key
# JANUARY_PROD_API_KEY=
# JANUARY_DEV_API_KEY=
