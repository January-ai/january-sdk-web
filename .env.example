# The React demo calls the standalone January Token Relay from its server function.
PARTNER_TOKEN_URL=http://127.0.0.1:8787/api/january/client-token
JANUARY_END_USER_ID=january-sdk-demo-user

# Required when PARTNER_TOKEN_URL points to a hosted development relay.
# PARTNER_APP_SESSION_TOKEN=your-relay-token

# Optional debug-only shortcut. Keep these server-side and never use VITE_.
# JANUARY_API_KEY=sk-your-local-development-key
# JANUARY_PROD_API_KEY=
# JANUARY_DEV_API_KEY=
