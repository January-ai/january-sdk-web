# Server-only credential used by the local token relay. Never use a VITE_ prefix.
JANUARY_API_KEY=sk-your-development-key
JANUARY_END_USER_ID=local-web-user

# The React demo's server-side token provider calls this local relay.
PARTNER_TOKEN_URL=http://127.0.0.1:8787/january-token

# Optional relay settings.
JANUARY_TOKEN_TTL_SECONDS=1800
JANUARY_TOKEN_RELAY_PORT=8787
