{
  "name": "@januaryai/web-sdk",
  "version": "0.1.0",
  "description": "The official January SDK for web applications",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/January-ai/january-sdk-web.git"
  },
  "homepage": "https://github.com/January-ai/january-sdk-web#readme",
  "bugs": {
    "url": "https://github.com/January-ai/january-sdk-web/issues"
  },
  "keywords": [
    "january",
    "nutrition",
    "partner-api",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "check:generated": "./scripts/check-generated-transport.sh",
    "smoke:live": "npm run build && node scripts/live-search.mjs",
    "smoke:all": "npm run build && node scripts/live-all.mjs",
    "pack:check": "npm pack --dry-run",
    "demo:web": "npm --prefix examples/react-demo run dev",
    "demo:web:build": "npm --prefix examples/react-demo run build",
    "demo:web:check": "npm --prefix examples/react-demo run check"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
